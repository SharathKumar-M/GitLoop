{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://gitloop.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gitloop.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}